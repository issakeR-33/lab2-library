{
  "name": "lab2-library",
  "version": "1.0.0",
  "description": "Клієнтський застосунок для керування бібліотекою на TypeScript (лабораторна робота №2).",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "mocha",
    "prepare": "husky",
    "deploy": "npm run build && gh-pages -d dist -e vite --add",
    "preview": "vite preview"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bootstrap": "^5.2.11",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "chai": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  },
  "private": true
}
